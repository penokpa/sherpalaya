# --- START ---

RewriteEngine On

# Redirect www → non-www (preserves path + query, 301 for SEO)
RewriteCond %{HTTP_HOST} ^www\.sherpalaya\.com$ [NC]
RewriteRule ^(.*)$ https://sherpalaya.com/$1 [R=301,L]

# Route requests to public/ (Laravel docroot pattern for cPanel + LiteSpeed)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]

<IfModule LiteSpeed>
   CacheLookup on
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# --- END ---
